&CONTROL
  calculation = 'scf',
  prefix      = 'nitrogen',
  outdir      = './tmp/',
  pseudo_dir  = '../../pseudos/',
  verbosity = 'high',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-8,
  etot_conv_thr = 1.0d-10,
  restart_mode = 'from_scratch',
  disk_io = 'nowf',
/

&SYSTEM
  ibrav =  0,
  nat  = 2,
  ntyp = 1,
  ecutwfc = 50.0,
  ecutrho = 200.0,
/

&ELECTRONS
  conv_thr = 1.0d-10,
  electron_maxstep = 200,
  mixing_beta = 0.7,
  mixing_mode = 'plain',
  scf_must_converge = .TRUE.,
  startingwfc = 'random',
/

ATOMIC_SPECIES
  N  14.0067 N.pbe-n-kjpaw_psl.1.0.0.UPF

